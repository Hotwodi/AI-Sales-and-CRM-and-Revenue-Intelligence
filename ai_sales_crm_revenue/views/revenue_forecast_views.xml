<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="scr_revenue_forecast_view_tree" model="ir.ui.view">
            <field name="name">scr.revenue.forecast.tree</field>
            <field name="model">scr.revenue.forecast</field>
            <field name="arch" type="xml">
                <tree string="Revenue Forecasts" decoration-info="scenario=='base'"
                      decoration-success="scenario=='optimistic'"
                      decoration-warning="scenario=='conservative'">
                    <field name="name"/>
                    <field name="period"/>
                    <field name="scenario"/>
                    <field name="forecast_amount" sum="Total Forecast"/>
                    <field name="actual_amount" sum="Total Actual"/>
                    <field name="variance" sum="Total Variance"/>
                    <field name="ai_confidence" widget="progressbar"/>
                    <field name="product_category_id"/>
                    <field name="currency_id" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="scr_revenue_forecast_view_form" model="ir.ui.view">
            <field name="name">scr.revenue.forecast.form</field>
            <field name="model">scr.revenue.forecast</field>
            <field name="arch" type="xml">
                <form string="Revenue Forecast">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="period"/>
                                <field name="scenario"/>
                                <field name="product_category_id"/>
                            </group>
                            <group>
                                <field name="forecast_amount"/>
                                <field name="actual_amount"/>
                                <field name="variance"/>
                                <field name="ai_confidence" widget="progressbar"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="scr_revenue_forecast_action" model="ir.actions.act_window">
            <field name="name">Revenue Forecasts</field>
            <field name="res_model">scr.revenue.forecast</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first revenue forecast
                </p>
            </field>
        </record>
    </data>
</odoo>
